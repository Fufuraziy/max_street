# Заголовки для Cloudflare Pages (в Docker-сборке файл не используется, кэш настраивает nginx.conf).
# Хешированные ассеты Vite кэшируются навсегда, index.html — всегда свежий.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache
