# Скопируйте в .env и при необходимости измените значения: cp .env.example .env
# Без .env проект тоже запускается — compose.yaml подставит значения по умолчанию.

# ---------- Порты на хосте ----------
FRONTEND_PORT=3000
BACKEND_PORT=8000

# ---------- PostgreSQL ----------
# База доступна только внутри docker-сети (порт наружу не публикуется).
# Значения совпадают с умолчаниями compose.yaml. Для продакшена задайте свой пароль;
# если volume уже создан со старым паролем, пересоздайте его: docker compose down -v
POSTGRES_USER=maxstreet
POSTGRES_PASSWORD=maxstreet_local
POSTGRES_DB=maxstreet

# ---------- Приложение ----------
APP_TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO
# Список origin через запятую; при работе через Nginx (порт 3000) CORS не нужен.
CORS_ORIGINS=https://fufuraziy.github.io,https://max-street.pages.dev,http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,http://localhost:8000,*
# Создавать демо-сборы и заявки при запуске (площадки загружаются всегда в пустую БД).
SEED_DEMO_DATA=true

# ---------- MAX Bot API ----------
# Данные бота хакатона: ID: 393483883, Имя: Хакатон МАХ 69, Username: @t69_hakaton_max_bot
# Токен бота: платформа MAX для партнёров → Чат-боты → Настройки. НЕ коммитьте реальный токен!
MAX_BOT_TOKEN=
MAX_API_BASE_URL=https://platform-api2.max.ru
# auto: webhook, если задан MAX_WEBHOOK_URL, иначе long polling (не нужен публичный HTTPS).
# Также: polling | webhook | disabled
MAX_BOT_MODE=auto
# Публичный HTTPS-адрес webhook (порт 443), например https://maxstreet.example.ru/webhook или /api/v1/bot/webhook
MAX_WEBHOOK_URL=
# Секрет webhook: 5–256 символов A-Z, a-z, 0-9, «-». Приходит в заголовке X-Max-Bot-Api-Secret.
MAX_WEBHOOK_SECRET=
# Кнопка open_app открывает мини-приложение внутри MAX; если MAX её отклонит, бот перейдёт на ссылки.
MAX_USE_OPEN_APP_BUTTON=true
# Публичный адрес мини-приложения:
MINIAPP_URL=https://fufuraziy.github.io/max_street


# ---------- Аренда кортов и безопасный сбор MAX Escrow ----------
# По регламенту хакатона оплата и бронирование эмулируются: mock-СБП и mock-арендодатель,
# реальные деньги не списываются. Mock-эндпоинты /api/v1/mock/* доступны только при PAYMENT_MODE=mock.
PAYMENT_MODE=mock
# Дедлайн сбора средств: за сколько минут до начала слота. Не собрали 100% — автоматический возврат.
ESCROW_DEADLINE_MINUTES=120
# Как часто фоновая задача проверяет дедлайны эскроу-сборов (секунды).
ESCROW_WATCHDOG_INTERVAL_SECONDS=30
# На сколько дней вперёд разворачивать расписание аренды из fixtures/court_slots_seed.json.
SLOTS_SEED_DAYS=5
# Вебхук во внешнюю систему арендодателя при выкупе слота (необязательно).
# Подпись тела: заголовок X-MaxStreet-Signature: sha256=<HMAC-SHA256(secret, body)>.
BOOKING_WEBHOOK_URL=
BOOKING_WEBHOOK_SECRET=

# ---------- Безопасность ----------
# true — действия в мини-приложении принимаются только с валидной подписью initData MAX
# (нужен MAX_BOT_TOKEN). false — разрешён гостевой режим в обычном браузере (удобно для демо).
REQUIRE_INIT_DATA=false
# Токен для смены статуса заявок о поломках (PATCH /api/v1/defects/{id}, заголовок X-Admin-Token).
ADMIN_TOKEN=
